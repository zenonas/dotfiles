# Dev Tools
cask 'cyberduck'
cask 'postman'
cask 'tableplus'
cask 'visual-studio-code'
cask 'wezterm'
cask 'ghostty'
brew 'colima', restart_service: true

# Tools for Work
cask 'google-chrome'
cask '1password'
cask '1password-cli'
cask 'notion'
cask 'figma'
cask 'ngrok'
cask 'zoom'

# General
brew 'duti'
cask 'discord'
cask 'mimestream'
cask 'vlc'
cask 'obsidian'
cask 'cloudflare-warp'

tap "nikitabobko/tap"
# Homebrew 7 refuses untrusted third-party taps; trusted: true only takes
# effect for a fully-qualified cask name (Utils.full_name? requires the
# "<tap>/<name>" form), so the token can't be left short here.
cask "nikitabobko/tap/aerospace", trusted: true

# Fonts
cask 'font-hasklig'
cask 'font-jetbrains-mono-nerd-font'
cask 'font-hack-nerd-font'
